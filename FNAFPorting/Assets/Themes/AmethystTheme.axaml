<controls:FPStyles xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:controls="clr-namespace:FNAFPorting.Controls">
    <controls:FPStyles.Resources>
        <Brush x:Key="FPSeparatorColorLayer1">#2F0075</Brush>
        <Brush x:Key="FPSeparatorColorLayer2">#4100A3</Brush>

        <Brush x:Key="FPButtonBackground">#2F0075</Brush>
        <Brush x:Key="FPButtonBackgroundPointerOver">#4100A3</Brush>
        <Brush x:Key="FPButtonBackgroundPressed">#5B2DA4</Brush>
        <Brush x:Key="FPButtonBorderBrush">#4100A3</Brush>

        <Brush x:Key="FPLayer2">#472380</Brush>
        <Brush x:Key="FPLayer2PointerOver">#5B2DA4</Brush>
        <Brush x:Key="FPLayer2Pressed">#472380</Brush>

        <Brush x:Key="FPButtonBackgroundSelected">#4100A3</Brush>
        <Brush x:Key="FPButtonBackgroundSelectedPointerOver">#2E2B3C</Brush>

        <Brush x:Key="FPButtonBackgroundBright">#4A3172</Brush>
        <Brush x:Key="FPButtonBackgroundBrightPointerOver">#4A3172</Brush>

        <LinearGradientBrush x:Key="FPContentCardBackground" StartPoint="0%, 0%" EndPoint="0%, 100%">
            <GradientStops>
                <GradientStop Color="#33195C" Offset="0"/>
                <GradientStop Color="#1F0F38" Offset="1"/>
            </GradientStops>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FPPopupContentCardBackground" StartPoint="0%, 0%" EndPoint="0%, 100%">
            <GradientStops>
                <GradientStop Color="#33195C" Offset="0"/>
                <GradientStop Color="#1F0F38" Offset="1"/>
            </GradientStops>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FPContentCardBackgroundBright" StartPoint="0%, 0%" EndPoint="0%, 100%">
            <GradientStops>
                <GradientStop Color="#4C3A69" Offset="0"/>
                <GradientStop Color="#21192E" Offset="1"/>
            </GradientStops>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="TextFillPrimaryBrush" Color="#D9D1E6" />
        <SolidColorBrush x:Key="TextFillPrimaryDisabledBrush" Color="#9380AC" />

        <SolidColorBrush x:Key="TextFillSecondaryBrush" Color="#C2B8D1" />
        <SolidColorBrush x:Key="TextFillSecondaryDisabledBrush" Color="#4F4063" />

        <SolidColorBrush x:Key="TextFillTertiaryBrush" Color="#7B659A" />
        <SolidColorBrush x:Key="TextFillTertiaryDisabledBrush" Color="#392E47" />

        <!-- Matches Dark value hierarchy: window > content border > layer2 (each step darker inward) -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0C0A0F" />
        <SolidColorBrush x:Key="ContentBorderBackgroundBrush" Color="#1F0641" />
        <SolidColorBrush x:Key="ContentBorderBorderBrush" Color="#2D095E" />

        <SolidColorBrush x:Key="ContentBorderLayer2BackgroundBrush" Color="#0B0217" />
        <SolidColorBrush x:Key="ContentBorderLayer2BorderBrush" Color="#2D095E" />

        <SolidColorBrush x:Key="DialogOverlayBackgroundBrush" Color="#80000010" />
        <SolidColorBrush x:Key="BroadcastOverlayBackgroundBrush" Color="#80000010" />

        <SolidColorBrush x:Key="FPTitleTextBrush" Color="#DDD8F0" />

        <Color x:Key="FPAccentColor">#812DFF</Color>
        <SolidColorBrush x:Key="FPAccentBrush" Color="{DynamicResource FPAccentColor}" />

        <Bitmap x:Key="FPLogoBitmap">avares://FNAFPorting/Assets/LogoBon.png</Bitmap>
    </controls:FPStyles.Resources>
</controls:FPStyles>
